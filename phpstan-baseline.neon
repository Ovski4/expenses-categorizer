parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$currentPage of method Pagerfanta\\Pagerfanta\<mixed\>\:\:setCurrentPage\(\) expects int, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Controller/TransactionController.php

		-
			message: '#^Call to an undefined method Doctrine\\ORM\\EntityRepository\<App\\Entity\\Transaction\>\:\:exists\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Controller/TransactionImportController.php

		-
			message: '#^Call to an undefined method Doctrine\\ORM\\EntityRepository\<App\\Entity\\Transaction\>\:\:getBalanceByAccount\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Controller/TransactionImportController.php

		-
			message: '#^Variable \$fileParser might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: src/Controller/TransactionImportController.php

		-
			message: '#^Property App\\Entity\\SubCategoryTransactionRule\:\:\$updatedAt \(DateTime\|null\) does not accept DateTimeInterface\.$#'
			identifier: assign.propertyType
			count: 1
			path: src/Entity/SubCategoryTransactionRule.php

		-
			message: '#^Call to an undefined method Spiriit\\Bundle\\FormFilterBundle\\Filter\\Query\\QueryInterface\:\:getExpr\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/FilterForm/SubCategoryTransactionRuleFilterType.php

		-
			message: '#^Call to an undefined method Spiriit\\Bundle\\FormFilterBundle\\Filter\\Query\\QueryInterface\:\:getExpr\(\)\.$#'
			identifier: method.notFound
			count: 4
			path: src/FilterForm/TransactionFilterType.php

		-
			message: '#^Variable \$expression might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: src/FilterForm/TransactionFilterType.php

		-
			message: '#^Variable \$operatorChoices might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: src/Form/SubCategoryTransactionRuleType.php

		-
			message: '#^Method App\\Kernel\:\:getAllowedEnvs\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: src/Kernel.php

		-
			message: '#^Call to protected method connect\(\) of class Doctrine\\DBAL\\Connection\.$#'
			identifier: method.protected
			count: 1
			path: src/Services/ConnectionKeeper.php

		-
			message: '#^Call to an undefined method Doctrine\\ORM\\Event\\OnFlushEventArgs\:\:getEntityManager\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Services/DoctrineListeners/ElasticsearchSyncStatusUpdater.php

		-
			message: '#^Access to an undefined property App\\Services\\DoctrineListeners\\ElasticsearchTransactionRemover\:\:\$elasticsearchHost\.$#'
			identifier: property.notFound
			count: 2
			path: src/Services/DoctrineListeners/ElasticsearchTransactionRemover.php

		-
			message: '#^Access to an undefined property App\\Services\\DoctrineListeners\\ElasticsearchTransactionRemover\:\:\$elasticsearchIndex\.$#'
			identifier: property.notFound
			count: 2
			path: src/Services/DoctrineListeners/ElasticsearchTransactionRemover.php

		-
			message: '#^Access to an undefined property App\\Services\\WebSocketMessageHandler\\AbstractWebSocketMessageHandler\:\:\$clients\.$#'
			identifier: property.notFound
			count: 4
			path: src/Services/WebSocketMessageHandler/AbstractWebSocketMessageHandler.php

		-
			message: '#^Access to an undefined property App\\Services\\WebSocketMessageHandler\\CategorizeTransactionsHandler\:\:\$clients\.$#'
			identifier: property.notFound
			count: 4
			path: src/Services/WebSocketMessageHandler/CategorizeTransactionsHandler.php

		-
			message: '#^Access to an undefined property App\\Services\\WebSocketMessageHandler\\ExportTransactionsHandler\:\:\$clients\.$#'
			identifier: property.notFound
			count: 3
			path: src/Services/WebSocketMessageHandler/ExportTransactionsHandler.php

		-
			message: '#^Access to an undefined property Symfony\\Component\\Validator\\Constraint\:\:\$message\.$#'
			identifier: property.notFound
			count: 1
			path: src/Validator/Constraints/AccountAliasesAreUniqueConstraintValidator.php

		-
			message: '#^Access to an undefined property Symfony\\Component\\Validator\\Constraint\:\:\$message\.$#'
			identifier: property.notFound
			count: 1
			path: src/Validator/Constraints/RuleIsCompleteConstraintValidator.php

		-
			message: '#^Access to an undefined property Symfony\\Component\\Validator\\Constraint\:\:\$message\.$#'
			identifier: property.notFound
			count: 1
			path: src/Validator/Constraints/RuleIsLogicalConstraintValidator.php

		-
